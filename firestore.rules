rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Produce Batches: Traceable crop and crate passports
    match /batches/{batchId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(batchId);
    }

    // User Profile Registry
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Quality Defect & Spoilage Watchdog Reports
    match /defects/{defectId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(defectId);
    }

    // Artifacts compatibility paths
    match /artifacts/{appId}/public/data/batches/{batchId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(batchId);
    }

    match /artifacts/{appId}/{document=**} {
      allow read, write: if true;
    }

    // Global Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
